@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var isAdmin = User.IsInRole(CD.SUPER_ADMIN_ROLE) || User.IsInRole(CD.ADMIN_ROLE);
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - HealthCare Admin</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hc-admin-shell d-flex flex-column">
    <a class="hc-skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark hc-admin-navbar" aria-label="Admin navigation">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill me-2" aria-hidden="true"></i>HealthCare <span class="fw-normal opacity-75">/ Admin</span>
                </a>
                <button class="navbar-toggler border-light-subtle" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav"
                        aria-controls="adminNav" aria-expanded="false" aria-label="Toggle admin navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="adminNav">
                    <ul class="navbar-nav me-auto my-2 my-lg-0">
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-1" aria-hidden="true"></i>Overview</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Clinic")" asp-area="Admin" asp-controller="Clinic" asp-action="Index"><i class="bi bi-hospital me-1" aria-hidden="true"></i>Clinics</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Doctor")" asp-area="Admin" asp-controller="Doctor" asp-action="Index"><i class="bi bi-person-badge me-1" aria-hidden="true"></i>Doctors</a></li>
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @Active("User")" asp-area="Admin" asp-controller="User" asp-action="Index"><i class="bi bi-people me-1" aria-hidden="true"></i>Users</a></li>
                        }
                    </ul>
                    <div class="d-flex flex-column flex-lg-row gap-2 align-items-lg-center">
                        <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>View public site</a>
                        <a class="btn btn-sm btn-light" asp-area="Identity" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-1" aria-hidden="true"></i>My profile</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <partial name="_Notifications" />

    <main id="main-content" class="hc-admin-main flex-grow-1" role="main">
        @if (ViewData["Title"] is string title)
        {
            <div class="mb-4">
                <h1 class="hc-admin-page-title">@title</h1>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="hc-admin-footer py-3">
        <div class="container-fluid px-lg-4 d-flex flex-column flex-sm-row justify-content-between gap-2 small">
            <span>&copy; @DateTime.Now.Year HealthCare Management System</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
