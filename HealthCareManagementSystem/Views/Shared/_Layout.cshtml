@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isStaff = User.IsStaff();
    var isPatient = User.IsInRole(CD.PATIENT_ROLE);
    var isDoctor = User.IsInRole(CD.DOCTOR_ROLE);
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    Func<string, string, string> active = (area, controller) =>
        string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}
                        @if (isDoctor)
                        {
                            <li class="nav-item"><a class="nav-link @active(CD.DOCTOR_AREA, "Home")" asp-area="@CD.DOCTOR_AREA" asp-controller="Home" asp-action="Index">Doctor dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @active(CD.DOCTOR_AREA, "Schedule")" asp-area="@CD.DOCTOR_AREA" asp-controller="Schedule" asp-action="Index">My availability</a></li>
                        }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthCare</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="hc-skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-lg hc-navbar" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand hc-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill"></i> HealthCare
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @active("", "Home")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (isPatient)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="doctors">Find a doctor</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @active(CD.PATIENT_AREA, "Appointment")" asp-area="@CD.PATIENT_AREA" asp-controller="Appointment" asp-action="Index">My appointments</a>
                            </li>
                        }
                                    @if (isDoctor)
                                    {
                                        <li><a class="dropdown-item" asp-area="@CD.DOCTOR_AREA" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Doctor dashboard</a></li>
                                    }

                        @if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="@CD.ADMIN_AREA" asp-controller="Home" asp-action="Index">Dashboard</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (signedIn)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img class="hc-avatar hc-avatar-sm" src="@Url.Content(ImagePaths.User(User.GetAvatar()))" alt="" />
                                    <span>@User.GetFullName()</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    @if (isPatient)
                                    {
                                        <li><a class="dropdown-item" asp-area="@CD.PATIENT_AREA" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>My dashboard</a></li>
                                    }
                                    @if (isStaff)
                                    {
                                        <li><a class="dropdown-item" asp-area="@CD.ADMIN_AREA" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-area="@CD.IDENTITY_AREA" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2"></i>My profile</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="@CD.IDENTITY_AREA" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="@CD.IDENTITY_AREA" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3" asp-area="@CD.IDENTITY_AREA" asp-controller="Account" asp-action="Register">Create account</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <partial name="_Notifications" />

    <main id="main-content" role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <footer class="hc-footer py-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year HealthCare Management System</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
