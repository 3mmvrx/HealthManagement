@model DoctorDashboardVM
@{
    ViewData["Title"] = "Doctor dashboard";
}

<section class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="hc-eyebrow">Doctor portal</span>
            <h1 class="h2 mt-2 mb-1">Welcome, Dr. @Model.Doctor.Name</h1>
            <p class="text-muted mb-0">@Model.Doctor.Specialization</p>
        </div>
        <a class="btn btn-primary" asp-area="Doctor" asp-controller="Schedule" asp-action="Index"><i class="bi bi-calendar-week me-1" aria-hidden="true"></i>Manage availability</a>
    </div>

    <div class="hc-card p-4">
        <h2 class="h4 mb-3">Your appointments</h2>
        @if (Model.Appointments.Count == 0)
        {
            <p class="text-muted mb-0">You have no appointments yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Patient</th><th>Date and time</th><th>Status</th><th>Reason</th></tr></thead>
                    <tbody>
                        @foreach (var appointment in Model.Appointments)
                        {
                            <tr>
                                <td>@appointment.Patient.Name</td>
                                <td>@appointment.AppointmentDate.ToString("ddd, MMM d, yyyy h:mm tt")</td>
                                <td><span class="badge @AppointmentRules.BadgeClass(appointment.Status)">@appointment.Status</span></td>
                                <td>@(string.IsNullOrWhiteSpace(appointment.Reason) ? "—" : appointment.Reason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
