@model DoctorSchedulesPageVM
@{
    ViewData["Title"] = "My availability";
    var days = Enum.GetValues<DayOfWeek>();
}

<section class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div><span class="hc-eyebrow">Doctor portal</span><h1 class="h2 mt-2 mb-1">My availability</h1><p class="text-muted mb-0">Manage your weekly clinic-local working hours.</p></div>
        <a class="btn btn-outline-secondary" asp-area="Doctor" asp-controller="Home" asp-action="Index">Back to dashboard</a>
    </div>

    <div class="hc-card p-4 mb-4">
        <h2 class="h5 mb-3">Schedule blocks</h2>
        @if (Model.Schedules.Count == 0)
        {
            <p class="text-muted mb-0">No hours configured. Patients cannot book until availability is added.</p>
        }
        else
        {
            <div class="d-grid gap-3">
                @foreach (var schedule in Model.Schedules)
                {
                    <div class="border rounded p-3">
                        <form asp-action="Save" method="post" class="row g-3 align-items-end">
                            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                            <input type="hidden" name="ScheduleId" value="@schedule.Id" />
                            <div class="col-sm-6 col-lg-3"><label class="form-label" for="day-@schedule.Id">Day</label><select class="form-select" id="day-@schedule.Id" name="DayOfWeek">@foreach (var day in days) { if (schedule.DayOfWeek == day) { <option value="@((int)day)" selected>@day</option> } else { <option value="@((int)day)">@day</option> } }</select></div>
                            <div class="col-sm-6 col-lg-2"><label class="form-label" for="start-@schedule.Id">Start</label><input class="form-control" id="start-@schedule.Id" name="StartTime" type="time" value="@schedule.StartTime.ToString("HH:mm")" required /></div>
                            <div class="col-sm-6 col-lg-2"><label class="form-label" for="end-@schedule.Id">End</label><input class="form-control" id="end-@schedule.Id" name="EndTime" type="time" value="@schedule.EndTime.ToString("HH:mm")" required /></div>
                            <div class="col-sm-6 col-lg-2"><label class="form-label" for="minutes-@schedule.Id">Slot minutes</label><input class="form-control" id="minutes-@schedule.Id" name="SlotMinutes" type="number" min="5" max="240" value="@schedule.SlotMinutes" required /></div>
                            <div class="col-lg-3"><button class="btn btn-primary" type="submit">Save changes</button></div>
                        </form>
                        <form asp-action="Delete" method="post" class="mt-2"><input type="hidden" name="scheduleId" value="@schedule.Id" /><button class="btn btn-outline-danger btn-sm" type="submit">Remove block</button></form>
                    </div>
                }
            </div>
        }
    </div>

    <div class="hc-card p-4">
        <h2 class="h5 mb-3">Add availability</h2>
        <form asp-action="Save" method="post" class="row g-3 align-items-end">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="col-sm-6 col-lg-3"><label asp-for="NewSchedule.DayOfWeek" class="form-label">Day</label><select name="DayOfWeek" asp-for="NewSchedule.DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"><option value="">Choose a day</option></select><span asp-validation-for="NewSchedule.DayOfWeek" class="text-danger small"></span></div>
            <div class="col-sm-6 col-lg-2"><label asp-for="NewSchedule.StartTime" class="form-label">Start</label><input name="StartTime" asp-for="NewSchedule.StartTime" type="time" class="form-control" /><span asp-validation-for="NewSchedule.StartTime" class="text-danger small"></span></div>
            <div class="col-sm-6 col-lg-2"><label asp-for="NewSchedule.EndTime" class="form-label">End</label><input name="EndTime" asp-for="NewSchedule.EndTime" type="time" class="form-control" /><span asp-validation-for="NewSchedule.EndTime" class="text-danger small"></span></div>
            <div class="col-sm-6 col-lg-2"><label asp-for="NewSchedule.SlotMinutes" class="form-label">Slot minutes</label><input name="SlotMinutes" asp-for="NewSchedule.SlotMinutes" type="number" min="5" max="240" class="form-control" /><span asp-validation-for="NewSchedule.SlotMinutes" class="text-danger small"></span></div>
            <div class="col-lg-3"><button class="btn btn-primary" type="submit">Add schedule block</button></div>
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
