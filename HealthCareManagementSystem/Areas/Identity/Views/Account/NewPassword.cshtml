@model NewPasswordVM
@{
    ViewData["Title"] = "Choose a new password";
}

<h1 class="h3 mb-2">Choose a new password</h1>
<p class="text-muted mb-4">Use a strong password you have not used before.</p>

<form asp-action="NewPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input asp-for="UserId" type="hidden" />
    <input asp-for="Token" type="hidden" />
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" autofocus />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
