@model ValidateOtpVM
@{
    ViewData["Title"] = "Verify your e-mail";
}

<h1 class="h3 mb-2">Enter your code</h1>
<p class="text-muted mb-4">Enter the 6-digit code sent to your e-mail address.</p>

<form asp-action="ValidateOtp" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input asp-for="UserNameOrEmail" type="hidden" />
    <div class="mb-4">
        <label asp-for="OTP" class="form-label"></label>
        <input asp-for="OTP" class="form-control form-control-lg text-center" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus />
        <span asp-validation-for="OTP" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Verify code</button>
</form>

<p class="text-center mt-4 mb-0"><a asp-action="ForgotPassword">Request another code</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
