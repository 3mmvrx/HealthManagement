@model ForgotPasswordVM
@{
    ViewData["Title"] = "Reset your password";
}

<h1 class="h3 mb-2">Reset your password</h1>
<p class="text-muted mb-4">Enter your user name or e-mail. If your account matches, we’ll send a verification code.</p>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="mb-4">
        <label asp-for="UserNameOrEmail" class="form-label"></label>
        <input asp-for="UserNameOrEmail" class="form-control form-control-lg" autocomplete="username" autofocus />
        <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Send verification code</button>
</form>

<p class="text-center mt-4 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to log in</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
