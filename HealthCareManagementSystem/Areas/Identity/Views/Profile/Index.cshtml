@model ProfilePageVM
@{
    ViewData["Title"] = "My profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mb-4">
        <img class="hc-avatar hc-avatar-xl" src="@Url.Content(ImagePaths.User(Model.ImageName))" alt="" />
        <div>
            <h1 class="hc-page-title">@Model.Profile.Name</h1>
            <p class="text-muted mb-0">@Model.Email <span aria-hidden="true">·</span> @Model.UserName</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="hc-card p-4 h-100" aria-labelledby="profile-heading">
                <h2 id="profile-heading" class="h5 mb-4">Personal details</h2>
                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Profile.Name" class="form-label"></label>
                        <input asp-for="Profile.Name" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Profile.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.Address" class="form-label"></label>
                        <input asp-for="Profile.Address" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="Profile.Address" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.PhoneNumber" class="form-label"></label>
                        <input asp-for="Profile.PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Profile.PhoneNumber" class="text-danger small"></span>
                    </div>
                    @if (Model.IsPatient)
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="Profile.Gender" class="form-label"></label>
                                <select asp-for="Profile.Gender" class="form-select">
                                    <option value="">Choose gender</option>
                                    <option value="Female">Female</option>
                                    <option value="Male">Male</option>
                                </select>
                                <span asp-validation-for="Profile.Gender" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Profile.DateOfBirth" class="form-label"></label>
                                <input asp-for="Profile.DateOfBirth" type="date" min="@DateTime.Today.AddYears(-99).ToString("yyyy-MM-dd")" max="@DateTime.Today.AddYears(-13).ToString("yyyy-MM-dd")" class="form-control" autocomplete="bday" />
                                <span asp-validation-for="Profile.DateOfBirth" class="text-danger small"></span>
                            </div>
                        </div>
                    }
                    <div class="mb-4">
                        <label asp-for="Profile.Image" class="form-label"></label>
                        <input asp-for="Profile.Image" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Profile.Image" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save profile</button>
                </form>
            </section>
        </div>

        <div class="col-lg-5">
            <section class="hc-card p-4 h-100" aria-labelledby="password-heading">
                <h2 id="password-heading" class="h5 mb-4">Change password</h2>
                <form asp-action="UpdatePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Password.CurrentPassword" class="form-label"></label>
                        <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password.CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password.NewPassword" class="form-label"></label>
                        <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password.ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="Password.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.ConfirmNewPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-primary">Update password</button>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
