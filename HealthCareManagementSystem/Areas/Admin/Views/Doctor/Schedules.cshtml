@model DoctorSchedulesPageVM

@{
    ViewData["Title"] = $"Availability — {Model.DoctorName}";
    var days = Enum.GetValues<DayOfWeek>();
}

<section class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="hc-eyebrow">Doctor availability</span>
            <h1 class="h2 mt-2 mb-1">@Model.DoctorName</h1>
            <p class="text-muted mb-0">Set weekly clinic-local hours and appointment length.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Update" asp-route-id="@Model.DoctorId">Back to doctor</a>
    </div>

    <div class="hc-card p-4 mb-4">
        <h2 class="h5 mb-3">Weekly schedule blocks</h2>

        @if (Model.Schedules.Count == 0)
        {
            <p class="text-muted mb-0">No availability is configured. Patients cannot book until at least one schedule block is added.</p>
        }
        else
        {
            <div class="d-grid gap-3">
                @foreach (var schedule in Model.Schedules)
                {
                    <div class="border rounded p-3">
                        <form asp-action="SaveSchedule" method="post" class="row g-3 align-items-end">
                            <input type="hidden" name="NewSchedule.DoctorId" value="@Model.DoctorId" />
                            <input type="hidden" name="NewSchedule.ScheduleId" value="@schedule.Id" />
                            <div class="col-sm-6 col-lg-3">
                                <label class="form-label" for="day-@schedule.Id">Day</label>
                                <select class="form-select" id="day-@schedule.Id" name="NewSchedule.DayOfWeek">
                                    @foreach (var day in days)
                                    {
                                        if (schedule.DayOfWeek == day)
                                        {
                                            <option value="@((int)day)" selected>@day</option>
                                        }
                                        else
                                        {
                                            <option value="@((int)day)">@day</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6 col-lg-2">
                                <label class="form-label" for="start-@schedule.Id">Start</label>
                                <input class="form-control" id="start-@schedule.Id" name="NewSchedule.StartTime" type="time" value="@schedule.StartTime.ToString("HH:mm")" required />
                            </div>
                            <div class="col-sm-6 col-lg-2">
                                <label class="form-label" for="end-@schedule.Id">End</label>
                                <input class="form-control" id="end-@schedule.Id" name="NewSchedule.EndTime" type="time" value="@schedule.EndTime.ToString("HH:mm")" required />
                            </div>
                            <div class="col-sm-6 col-lg-2">
                                <label class="form-label" for="length-@schedule.Id">Slot minutes</label>
                                <input class="form-control" id="length-@schedule.Id" name="NewSchedule.SlotMinutes" type="number" min="5" max="240" value="@schedule.SlotMinutes" required />
                            </div>
                            <div class="col-lg-3 d-flex gap-2">
                                <button class="btn btn-primary" type="submit">Save</button>
                            </div>
                        </form>
                        <form asp-action="DeleteSchedule" method="post" class="mt-2">
                            <input type="hidden" name="doctorId" value="@Model.DoctorId" />
                            <input type="hidden" name="scheduleId" value="@schedule.Id" />
                            <button class="btn btn-outline-danger btn-sm" type="submit">Remove block</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>

    <div class="hc-card p-4">
        <h2 class="h5 mb-3">Add availability</h2>
        <form asp-action="SaveSchedule" method="post" class="row g-3 align-items-end">
            <input asp-for="NewSchedule.DoctorId" type="hidden" />
            <div class="col-sm-6 col-lg-3">
                <label asp-for="NewSchedule.DayOfWeek" class="form-label">Day</label>
                <select asp-for="NewSchedule.DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select">
                    <option value="">Choose a day</option>
                </select>
                <span asp-validation-for="NewSchedule.DayOfWeek" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label asp-for="NewSchedule.StartTime" class="form-label">Start</label>
                <input asp-for="NewSchedule.StartTime" type="time" class="form-control" />
                <span asp-validation-for="NewSchedule.StartTime" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label asp-for="NewSchedule.EndTime" class="form-label">End</label>
                <input asp-for="NewSchedule.EndTime" type="time" class="form-control" />
                <span asp-validation-for="NewSchedule.EndTime" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label asp-for="NewSchedule.SlotMinutes" class="form-label">Slot minutes</label>
                <input asp-for="NewSchedule.SlotMinutes" type="number" min="5" max="240" class="form-control" />
                <span asp-validation-for="NewSchedule.SlotMinutes" class="text-danger small"></span>
            </div>
            <div class="col-lg-3">
                <button class="btn btn-primary" type="submit">Add schedule block</button>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
