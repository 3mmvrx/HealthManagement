@model AdminUserRowVM
@{
    ViewData["Title"] = "Delete user";
}

<section class="container py-4">
    <div class="hc-admin-card p-4 mx-auto" style="max-width: 720px">
        <span class="hc-eyebrow text-danger">Permanent action</span>
        <h2 class="h3 mt-2">Delete @Model.User.UserName?</h2>
        <p>This permanently deletes the account and, if it is a Patient account, its patient profile, appointments, medical records, prescriptions, uploaded-file records, and clinic/doctor links. This cannot be undone.</p>
        <dl class="row">
            <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.User.Name</dd>
            <dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@Model.User.Email</dd>
            <dt class="col-sm-3">Role</dt><dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>
        </dl>
        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" name="id" value="@Model.User.Id" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">Delete account and linked data</button>
            </div>
        </form>
    </div>
</section>
