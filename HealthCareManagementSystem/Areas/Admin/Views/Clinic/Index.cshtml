@model IEnumerable<HealthCareManagementSystem.Models.Clinic>

@{
    ViewData["Title"] = "Clinics";
}

<section aria-label="Clinic management">

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">

        <p class="text-muted mb-0">Manage clinic locations and contact details.</p>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Clinic
        </a>

    </div>

        <div class="hc-admin-table-wrap">
            <table class="table table-hover hc-admin-table">
                <caption class="visually-hidden">Clinic directory</caption>

        <thead>

            <tr>
                <th scope="col">Image</th>
                <th scope="col">Name</th>
                <th scope="col">Address</th>
                <th scope="col">Phone number</th>
                <th scope="col">Description</th>
                <th scope="col">Actions</th>
            </tr>

        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var clinic in Model)
                {
                    <tr>

                        <td class="text-center">

                            @if (!string.IsNullOrEmpty(clinic.ImageName))
                            {
                                <img src="@Url.Content(ImagePaths.Clinic(clinic.ImageName))"
                                     alt="@clinic.Name"
                                     class="hc-admin-thumbnail" />
                            }
                            else
                            {
                                <img src="@Url.Content(ImagePaths.Clinic(null))"
                                     alt=""
                                     class="hc-admin-thumbnail" />
                            }

                        </td>

                        <td>@clinic.Name</td>

                        <td>@clinic.Address</td>

                        <td>@clinic.PhoneNumber</td>

                        <td>@clinic.Description</td>

                        <td>

                            @* <a asp-action="Details"
                               asp-route-id="@clinic.Id"
                               class="btn btn-info btn-sm">
                                Details
                            </a> *@

                            <a asp-action="Update"
                               asp-route-id="@clinic.Id"
                               class="btn btn-outline-primary btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@clinic.Id"
                               class="btn btn-outline-danger btn-sm">
                                Delete
                            </a>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="6" class="text-center text-muted py-4">

                        No Clinics Found

                    </td>

                </tr>
            }

        </tbody>

            </table>
        </div>

</section>
