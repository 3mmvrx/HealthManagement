@{
    ViewData["Title"] = "Page not found";
}

<section class="hc-empty mx-auto" style="max-width: 42rem;">
    <span class="auth-icon mb-3" aria-hidden="true"><i class="bi bi-search"></i></span>
    <h2 class="h4">This page could not be found</h2>
    <p class="text-muted">The address may have changed or may no longer be available.</p>
    <a class="btn btn-primary" asp-area="Admin" asp-controller="Home" asp-action="Index">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Return to dashboard
    </a>
</section>
